<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
<title>{{ pageTitle | default(site.title) }} | {{ site.author }}</title>
<meta name="description" content="{{ description | default(site.description) }}">
{% if keywords %}
<meta name="keywords" content="{{ keywords }}">
{% endif %}
<meta name="author" content="{{ site.author }}">
{% if robots %}
<meta name="robots" content="{{ robots }}">
{% endif %}

<!-- Open Graph Tags (immer ausgegeben; Fallbacks: pageTitle -> site.title, description -> site.description) -->
<meta property="og:title" content="{{ ogTitle | default(pageTitle) | default(site.title) }} | {{ site.author }}">
<meta property="og:description" content="{{ ogDescription | default(description) | default(site.description) }}">
<meta property="og:type" content="{{ ogType | default('website') }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="de_DE">
<meta property="og:image" content="{{ ogImage | default(site.url + '/assets/images/og-default.jpg') }}">
<meta property="og:image:width" content="{{ ogImageWidth | default(1200) }}">
<meta property="og:image:height" content="{{ ogImageHeight | default(630) }}">
<meta property="og:image:alt" content="{{ ogImageAlt | default('Optionen strategisch nutzen – Praxishandbuch von Markus Lehleiter') }}">
<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle | default(pageTitle) | default(site.title) }} | {{ site.author }}">
<meta name="twitter:description" content="{{ ogDescription | default(description) | default(site.description) }}">
<meta name="twitter:image" content="{{ ogImage | default(site.url + '/assets/images/og-default.jpg') }}">

{% if canonical %}
<link rel="canonical" href="{{ canonical }}" />
{% else %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
{% endif %}

<!-- Structured Data: WebSite + Person -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Just Options",
      "alternateName": "Optionen strategisch nutzen",
      "url": "{{ site.url }}",
      "description": "{{ site.description }}",
      "inLanguage": "de",
      "publisher": {
        "@id": "{{ site.url }}/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "image": "{{ site.url }}/assets/images/autor.jpg",
      "jobTitle": "Autor & Optionshändler",
      "sameAs": [
        "{{ site.social.linkedin }}",
        "{{ site.social.instagram }}",
        "{{ site.social.telegram }}"
      ]
    }
  ]
}
</script>

<!-- Security Headers -->
<meta http-equiv="X-Content-Type-Options" content="nosniff">
<meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
<meta name="referrer" content="strict-origin-when-cross-origin">

<!-- Favicon -->
<link rel="icon" href="/assets/images/favicon.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/assets/images/favicon.png">

<!-- Kritische Schriften vorladen: reduziert FOUT und verbessert den LCP.
     Fraunces 600 = Überschriften (u. a. Hero-H1), Inter 400 = Fließtext.
     crossorigin ist für Font-Preloads zwingend (Fonts werden im CORS-Modus geladen). -->
<link rel="preload" href="/assets/fonts/fraunces-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>

<!-- Stylesheets gebündelt + minifiziert; Font-Awesome-Icons sind als lokales Inline-SVG enthalten (kein Drittanbieter) -->

<link rel="stylesheet" href="{{ cssBundle }}">
{% if extraCss %}
{% for css in extraCss %}
<link rel="stylesheet" href="{{ css }}">
{% endfor %}
{% endif %}