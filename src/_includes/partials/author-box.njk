<aside class="author-box">
    {% image "assets/images/autor-square.jpg", author.name, "96px", "lazy", "author-box-img", [96, 192] %}
    <div class="author-box-body">
        <p class="author-box-name">{{ author.name }} <span class="author-box-credentials">· {{ author.credentialsShort }}</span></p>
        <p class="author-box-bio">{{ author.bioShort | safe }}</p>
        <a href="{{ author.profileUrl }}" class="author-box-link">{{ author.profileLinkLabel | safe }}</a>
    </div>
</aside>
