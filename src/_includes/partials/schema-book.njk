{#- Book-JSON-LD aus content/products.yaml. Aufruf: {% set product = products.book %}{% include "partials/schema-book.njk" %} -#}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Book","name":{{ product.title | dump | safe }},"author":{"@type":"Person","name":{{ author.name | dump | safe }}},"isbn":"{{ product.isbn }}","numberOfPages":{{ product.pages }},"datePublished":"{{ product.datePublished }}","bookFormat":"https://schema.org/Paperback","inLanguage":"de","image":"{{ site.url }}{{ product.image }}","url":"{{ site.url }}{{ product.url }}","offers":{"@type":"Offer","price":"{{ product.price }}","priceCurrency":"EUR","url":"{{ product.amazonUrl }}"}}</script>
