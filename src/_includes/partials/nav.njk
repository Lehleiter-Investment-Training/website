<header class="site-header">
    <nav aria-label="Hauptnavigation">
        <div class="nav-container">
            <div class="logo">
                <a href="/">
                    <img src="/assets/images/logo.png" alt="just OPTIONS Logo" width="500" height="250" decoding="async">
                </a>
            </div>
            <ul class="nav-links" id="navLinks">
                {% for item in navigation.main %}
                {% if item.children %}
                <li class="has-dropdown">
                    <a href="{{ item.url }}" aria-haspopup="true" aria-expanded="false">{{ item.label }} <i class="fas fa-chevron-down dropdown-icon" aria-hidden="true"></i></a>
                    <ul class="dropdown-menu" role="menu">
                        {% for child in item.children %}
                        <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
                {% elif item.isCta %}
                <li><a href="{{ item.url }}" class="nav-cta">{{ item.label }}</a></li>
                {% else %}
                <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                {% endif %}
                {% endfor %}
            </ul>
            <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navLinks">
                <span class="menu-icon" aria-hidden="true"></span>
            </button>
        </div>
    </nav>
</header>