{#-
  Produkt-Hero für Buch, Workbook und KI-Kurs.
  Erwartet: hero (aus content/pages/<seite>.yaml) und product (aus content/products.yaml).
  hero: eyebrow, title, paragraphs[], showMeta, cta.label, secondary?{label,url}, note?, imageAlt
-#}
{% import "macros/ui.njk" as ui %}
<section class="brand-section product-page">
  <div class="container product-feature">
    <div class="product-copy">
      <p class="eyebrow">{{ hero.eyebrow | safe }}</p>
      <h1>{{ hero.title | safe }}</h1>
      {{ ui.paragraphs(hero.paragraphs) }}
      {% if hero.showMeta %}<p class="product-meta">{{ product.priceDisplay }} · {{ product.pages }} Seiten · {{ product.format }}<br><span class="small-copy">Erschienen am {{ product.datePublishedDisplay }}</span></p>{% endif %}
      <div class="actions">
        <a href="{{ product.amazonUrl or product.platformUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">{{ hero.cta.label | safe }}</a>
        {%- if hero.secondary %}{{ ui.link(hero.secondary) }}{% endif %}
      </div>
      {% if hero.note %}<p class="small-copy">{{ hero.note | safe }}</p>{% endif %}
    </div>
    <div class="product-image">{% image product.image.slice(1), hero.imageAlt, "(max-width: 700px) 65vw, 300px", "eager" %}</div>
  </div>
</section>
