{#- Texte: content/partials/blog-cta.yaml -#}
{%- set cta = partials["blog-cta"] -%}
{%- set v = cta.variants[pillar] or cta.variants.default -%}
<div class="blog-cta-section">
  <div class="next-step">
    <p class="eyebrow">{{ cta.eyebrow | safe }}</p>
    <h2>{{ v.title | safe }}</h2>
    <p>{{ v.text | safe }}</p>
    <a href="{{ v.cta.url }}" class="btn btn-primary">{{ v.cta.label | safe }}</a>
    <p class="small-copy" style="margin-top:20px"><a href="{{ cta.starterkit.url }}">{{ cta.starterkit.label | safe }}</a></p>
  </div>
</div>
