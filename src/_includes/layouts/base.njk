{#- Seiten mit pageKey: Titel/Beschreibung/Untertitel aus content/pages/<pageKey>.yaml (copy.meta) -#}
{%- if copy and copy.meta -%}
{%- if copy.meta.title %}{% set pageTitle = copy.meta.title %}{% endif -%}
{%- if copy.meta.description %}{% set description = copy.meta.description %}{% endif -%}
{%- if copy.meta.subtitle %}{% set subtitle = copy.meta.subtitle %}{% endif -%}
{%- endif %}
<!DOCTYPE html>
<html lang="de"{% if schemaType %} itemscope itemtype="http://schema.org/{{ schemaType }}"{% endif %}>
<head>
    {% include "partials/head.njk" %}
</head>
<body>
    <a href="#main-content" class="skip-link visually-hidden">Zum Inhalt springen</a>
    {% include "partials/nav.njk" %}

    <main id="main-content">
    {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}


    <!-- Globale UI-Logik (Mobile-Menu, Smooth-Scroll, Formular) -->
    <script src="/assets/js/main.js" defer></script>
</body>
</html>