---
layout: layouts/base.njk
ogType: article
extraCss:
  - /assets/css/blog.css
---
<section class="page-title">
    <div class="container">
        <h1>{{ pageTitle }}</h1>
        {% if subtitle %}
        <p>{{ subtitle }}</p>
        {% endif %}
    </div>
</section>

<section>
    <div class="container">
        <div class="blog-content blog-article-body">
            {% if summary %}
            <div class="answer-box">
                <p class="answer-box-label">Kurz &amp; knapp</p>
                <p>{{ summary }}</p>
            </div>
            {% endif %}
            {{ content | safe }}
        </div>

        {% if faq %}
        <section class="blog-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Häufige Fragen</h2>
            {% for item in faq %}
            <details class="faq-item">
                <summary>{{ item.q }}</summary>
                <div class="faq-answer">{{ item.a | safe }}</div>
            </details>
            {% endfor %}
        </section>
        {% endif %}

        {% include "partials/author-box.njk" %}
        {% include "partials/related-posts.njk" %}
        {% include "partials/blog-cta.njk" %}
    </div>
</section>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ pageTitle }}",
    "description": "{{ description }}",
    "inLanguage": "de",
    "author": {
        "@type": "Person",
        "name": "Markus Lehleiter",
        "jobTitle": "CFA, FRM",
        "url": "https://www.just-options.de"
    },
    {% if date %}"datePublished": "{{ date | isoDate }}",{% endif %}
    {% if lastModified %}"dateModified": "{{ lastModified | isoDate }}",{% elif date %}"dateModified": "{{ date | isoDate }}",{% endif %}
    "image": "https://www.just-options.de{% if image %}{{ image }}{% else %}/assets/images/og-default.jpg{% endif %}",
    {% if tags %}"keywords": "{{ tags | join(', ') }}",{% endif %}
    "publisher": {
        "@type": "Organization",
        "name": "just OPTIONS",
        "url": "https://www.just-options.de",
        "logo": {
            "@type": "ImageObject",
            "url": "https://www.just-options.de/assets/images/logo.jpg"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.just-options.de{{ page.url }}"
    }
}
</script>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.just-options.de/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://www.just-options.de/blog.html"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ pageTitle }}"
        }
    ]
}
</script>

{% if faq %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% for item in faq %}{
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ item.a | dump | safe }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}
