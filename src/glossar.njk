---
layout: layouts/base.njk
pageTitle: "Optionen-Glossar"
description: "Umfassendes Glossar mit den wichtigsten Begriffen aus dem Optionshandel. Von A wie Assignment bis Z wie Zeitwert."
permalink: /glossar.html
extraCss: ["/assets/css/bonus.css"]
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "{{ site.url }}/glossar.html#glossar",
  "name": "Optionen-Glossar",
  "description": "Die wichtigsten Begriffe aus dem Optionshandel verständlich erklärt.",
  "url": "{{ site.url }}/glossar.html",
  "inLanguage": "de",
  "hasDefinedTerm": [
    {% for item in glossar.terms %}{
      "@type": "DefinedTerm",
      "name": {{ item.term | dump | safe }},
      "alternateName": {{ item.english | dump | safe }},
      "description": {{ item.definition | dump | safe }},
      "inDefinedTermSet": "{{ site.url }}/glossar.html#glossar"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

    <header class="header">
        <a href="/" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Zurück zur Startseite
        </a>
        <h1><i class="fas fa-book-open"></i> Optionen-Glossar</h1>
        <p>Die wichtigsten Begriffe aus dem Optionshandel verständlich erklärt</p>
    </header>

    <div class="search-container">
        <i class="fas fa-search search-icon"></i>
        <input type="text" class="search-box" id="searchInput" placeholder="Begriff suchen...">
        <div class="search-count" id="searchCount">{{ glossar.count }} Begriffe verfügbar</div>
    </div>

    <nav class="alphabet-nav" id="alphabetNav">
        {% for l in glossar.alphabet %}
        <a href="#{{ l.letter }}"{% if not l.used %} class="disabled"{% endif %}>{{ l.letter }}</a>
        {% endfor %}
    </nav>

    <main class="container" id="glossaryContent">
        {% for group in glossar.byLetter %}
        <div class="letter-section" id="{{ group.letter }}">
            <div class="letter-header">
                <span>{{ group.letter }}</span>
                <h2>{{ group.items.length }} Begriff{% if group.items.length > 1 %}e{% endif %}</h2>
            </div>
            {% for item in group.items %}
            <div class="term-card{% if 'Grundlagen' in item.tags %} highlight{% endif %}" data-search="{{ (item.term ~ ' ' ~ item.english ~ ' ' ~ item.definition ~ ' ' ~ (item.tags | join(' '))) | lower }}">
                <h3 class="term-title">
                    {{ item.term }}
                    <span class="english">({{ item.english }})</span>
                </h3>
                <p class="term-definition">{{ item.definition }}</p>
                {% if item.example %}<div class="term-example"><strong>Beispiel:</strong> {{ item.example }}</div>{% endif %}
                {% if item.tags.length %}<div class="term-tags">{% for t in item.tags %}<span class="term-tag">{{ t }}</span>{% endfor %}</div>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        <div class="no-results" id="noResults" hidden>
            <i class="fas fa-search"></i>
            <p>Keine Begriffe gefunden für "<span id="noResultsTerm"></span>"</p>
        </div>
    </main>

    <footer class="footer">
        <p>&copy; 2025 <a href="/">Just Options</a> - Markus Lehleiter</p>
    </footer>

<script src="/assets/js/glossar.js"></script>
