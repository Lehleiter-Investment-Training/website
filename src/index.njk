---
layout: layouts/base.njk
pageKey: startseite
permalink: /index.html
---
{#- Texte: content/pages/startseite.yaml · Autor: content/author.yaml · Buchdaten: content/products.yaml -#}
{% import "macros/ui.njk" as ui %}
{%- set c = copy -%}

<section class="brand-hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{{ c.hero.eyebrow | safe }}</p>
      <h1>{{ c.hero.title | safe }}</h1>
      <p class="hero-lead">{{ c.hero.lead | safe }}</p>
      <p class="hero-tagline">{{ c.hero.tagline | safe }}</p>
      <div class="actions">{{ ui.link(c.hero.cta, "btn btn-primary") }}{{ ui.link(c.hero.secondary, "text-link light-link") }}</div>
      <p class="hero-note">{{ c.hero.note | safe }}</p>
    </div>
    <aside class="decision-sheet">
      <div class="sheet-heading"><span>{{ c.decisionSheet.label | safe }}</span><span>{{ c.decisionSheet.counter | safe }}</span></div>
      <h2>{{ c.decisionSheet.title | safe }}</h2>
      <p>{{ c.decisionSheet.intro | safe }}</p>
      <ol class="decision-list">
        {%- for item in c.decisionSheet.items %}<li><span>{{ item.index }}</span><div><strong>{{ item.title | safe }}</strong><p>{{ item.text | safe }}</p></div></li>{% endfor -%}
      </ol>
      {{ ui.link(c.decisionSheet.link) }}
    </aside>
  </div>
</section>

<div class="trust-strip"><div class="container"><span>{{ author.name }} · {{ author.role }}</span><span>{{ author.experience }}</span><span>{{ author.credentials }}</span></div></div>

<section id="lernweg" class="brand-section">
  <div class="container">
    {{ ui.sectionIntro(c.lernweg) }}
    <div class="learning-grid">
      {% for step in c.lernweg.steps %}
      <article class="learning-step"><span class="step-index">{{ step.index }}</span><p class="pill">{{ step.pill | safe }}</p><h3>{{ step.title | safe }}</h3><p>{{ step.text | safe }}</p><p class="step-tools">{{ step.tools | safe }}</p>{{ ui.link(step.link) }}</article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="brand-section muted-section">
  <div class="container">
    {{ ui.sectionIntro(c.pillars) }}
    <div class="pillar-grid">
      {% for p in c.pillars.items %}
      <article><span class="topic-number">{{ p.number | safe }}</span><h3>{{ p.title | safe }}</h3><p>{{ p.text | safe }}</p>{{ ui.link(p.link) }}</article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="book" class="brand-section">
  <div class="container product-feature">
    <div class="product-image">{% image products.book.image.slice(1), c.book.imageAlt, "(max-width: 768px) 65vw, 300px", "lazy" %}</div>
    <div class="product-copy">
      <p class="eyebrow">{{ c.book.eyebrow | safe }}</p>
      <h2>{{ c.book.title | safe }}</h2>
      {{ ui.paragraphs(c.book.paragraphs) }}
      <p class="product-meta">{{ products.book.pages }} Seiten · {{ products.book.format }} · {{ products.book.priceDisplay }}</p>
      <div class="actions">{{ ui.link(c.book.cta, "btn btn-primary") }}{{ ui.link(c.book.secondary) }}</div>
      {{ ui.link(c.book.followup, "product-followup") }}
    </div>
  </div>
</section>

<section id="kurs" class="brand-section navy-section">
  <div class="container split-section">
    <div>
      <p class="eyebrow">{{ c.kurs.eyebrow | safe }}</p>
      <h2>{{ c.kurs.title | safe }}</h2>
      {{ ui.paragraphs(c.kurs.paragraphs) }}
      {{ ui.link(c.kurs.cta, "btn btn-primary") }}
    </div>
    <div class="workflow">
      {%- for w in c.kurs.workflow %}<div><span>{{ w.index }}</span><p><strong>{{ w.title | safe }}</strong><br>{{ w.text | safe }}</p></div>{% endfor -%}
    </div>
  </div>
</section>

<section class="brand-section">
  <div class="container section-intro">
    {{ ui.sectionIntro(c.aktienanleihen, wrap=false) }}
    {{ ui.link(c.aktienanleihen.link) }}
  </div>
</section>

<section id="author" class="brand-section muted-section">
  <div class="container author-feature">
    <div>{% image "assets/images/autor.jpg", c.author.imageAlt, "(max-width: 768px) 220px, 280px", "lazy" %}</div>
    <div>
      <p class="eyebrow">{{ c.author.eyebrow | safe }}</p>
      <h2>{{ author.name }}</h2>
      {{ ui.paragraphs(c.author.paragraphs) }}
      {{ ui.link(c.author.link) }}
      <span id="reviews"></span>
      <p class="small-copy"><a href="{{ products.book.amazonUrl }}" target="_blank" rel="noopener noreferrer">{{ c.author.reviewsLabel | safe }}</a></p>
    </div>
  </div>
</section>

<section id="faq" class="brand-section">
  <div class="container narrow">
    <p class="eyebrow">{{ c.faq.eyebrow | safe }}</p>
    <h2>{{ c.faq.title | safe }}</h2>
    {{ ui.faqList(c.faq.items) }}
  </div>
</section>

{% include "partials/starterkit.njk" %}
