---
layout: layouts/page.njk
pageKey: danke
permalink: /Danke.html
robots: "noindex, nofollow"
extraCss: ["/assets/css/leadgen.css"]
---
{#- Texte: content/pages/danke.yaml · Preise/Links: content/products.yaml -#}
{%- set d = copy -%}
<div class="danke-main">
    <div class="danke-container">

        <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h2 class="danke-heading">{{ d.heading | safe }}</h2>
        <p class="danke-subheading">{{ d.subheading | safe }}</p>

        <div class="download-card">
            <div class="card-badge">{{ d.download.badge | safe }}</div>
            <h3 class="download-title">{{ d.download.title | safe }}</h3>
            <p class="download-desc">{{ d.download.text | safe }}</p>

            <a href="{{ d.download.url }}" class="btn-download" download>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                {{ d.download.label | safe }}
            </a>

            <div class="file-info">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                    {{ d.download.facts[0] | safe }}
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    {{ d.download.facts[1] | safe }}
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    {{ d.download.facts[2] | safe }}
                </span>
            </div>
        </div>

        <div class="next-steps">
            <h3>{{ d.nextSteps.title | safe }}</h3>
            <div class="steps-grid">
                {% for step in d.nextSteps.items %}
                <div class="step-card">
                    <div class="step-number">{{ loop.index }}</div>
                    <h4>{{ step.title | safe }}</h4>
                    <p>{{ step.text | safe }}</p>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="book-recommendation">
            <h3>{{ d.books.title | safe }}</h3>
            <div class="book-rec-grid">
                <div class="book-rec-card">
                    {% image products.book.image.slice(1), d.books.book.imageAlt, "120px", "lazy", "book-rec-img", [120, 240] %}
                    <h4>{{ d.books.book.title | safe }}</h4>
                    <p>{{ d.books.book.text | safe }}</p>
                    <div class="book-rec-price">{{ products.book.priceDisplay }}</div>
                    <a href="{{ products.book.amazonUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">{{ d.books.buyLabel | safe }}</a>
                </div>
                <div class="book-rec-card">
                    {% image products.workbook.image.slice(1), d.books.workbook.imageAlt, "120px", "lazy", "book-rec-img", [120, 240] %}
                    <h4>{{ d.books.workbook.title | safe }}</h4>
                    <p>{{ d.books.workbook.text | safe }}</p>
                    <div class="book-rec-price">{{ products.workbook.priceDisplay }}</div>
                    <a href="{{ products.workbook.amazonUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">{{ d.books.buyLabel | safe }}</a>
                </div>
            </div>
        </div>

        <div class="danke-telegram">
            <div class="telegram-banner">
                <div class="container">
                    <div class="telegram-banner-text">
                        <i class="fab fa-telegram"></i>
                        <div>
                            <h3>{{ d.telegram.title | safe }}</h3>
                            <p>{{ d.telegram.text | safe }}</p>
                        </div>
                    </div>
                    <a href="{{ site.social.telegram }}" class="btn" target="_blank" rel="noopener noreferrer">{{ d.telegram.label | safe }}</a>
                </div>
            </div>
        </div>

    </div>
</div>
