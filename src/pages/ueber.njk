---
layout: layouts/base.njk
pageKey: ueber
permalink: "/ueber/index.html"
---
{#- Texte: content/pages/ueber.yaml -#}
{% import "macros/ui.njk" as ui %}
<section class="brand-section">
  <div class="container author-feature">
    <div>{% image "assets/images/autor.jpg", copy.hero.imageAlt, "(max-width: 700px) 220px, 280px", "eager" %}</div>
    <div>
      {{ ui.sectionIntro(copy.hero, tag="h1", wrap=false) }}
      {{ ui.paragraphs(copy.hero.paragraphs) }}
    </div>
  </div>
</section>
<section class="brand-section muted-section">
  <div class="container prose">
    <h2>{{ copy.experience.title | safe }}</h2>
    {{ ui.paragraphs(copy.experience.paragraphs) }}
    <p><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">{{ copy.experience.linkedinLabel | safe }}</a></p>
  </div>
</section>
<section class="brand-section">
  <div class="container prose">
    <h2>{{ copy.principles.title | safe }}</h2>
    {% for item in copy.principles.items %}<h3>{{ item.title | safe }}</h3><p>{{ item.text | safe }}</p>{% endfor %}
    {{ ui.nextStep(copy.next) }}
  </div>
</section>
